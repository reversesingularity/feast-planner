# AWS Cognito Configuration
# Copy this file to .env.local and fill in your values

# AWS Cognito User Pool ID (e.g., us-east-1_abc123xyz)
VITE_AWS_USER_POOL_ID=your_user_pool_id_here

# AWS Cognito User Pool Client ID (e.g., 1234567890abcdef)
VITE_AWS_USER_POOL_CLIENT_ID=your_app_client_id_here

# AWS Region (e.g., us-east-1)
VITE_AWS_REGION=us-east-1
